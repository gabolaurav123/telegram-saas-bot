BOT_TOKEN=123456:telegram_bot_token
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Use OWNER_ID for one owner or OWNER_IDS for multiple owners.
OWNER_ID=123456789
# OWNER_IDS=123456789,987654321

APP_ENV=production
APP_TIMEZONE=America/La_Paz
PUBLIC_BRAND_NAME=Premium Access
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=["es","en","pt"]
LOG_LEVEL=INFO
LOG_TO_FILE=true

SUPPORT_URL=https://t.me/tu_soporte
FAQ_URL=
ADMIN_NOTIFICATION_CHAT_ID=
DEFAULT_CURRENCY=USD
# USD value for 1 unit of each currency. Use current rates and update them when needed.
CURRENCY_USD_RATES={"USD":"1","MXN":"0.05926","BOB":"0.145","EUR":"1.08","COP":"0.00025","ARS":"0.001"}
INVITE_LINK_TTL_MINUTES=30
APPROVED_INVITE_LINK_TTL_HOURS=10

RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_EVENTS=8

SCHEDULER_ENABLED=true
EXPIRE_CHECK_MINUTES=15
REMINDER_CHECK_MINUTES=60
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=backups
PG_DUMP_PATH=pg_dump

BROADCAST_BATCH_SIZE=25
BROADCAST_BATCH_DELAY_SECONDS=1
BROADCAST_MAX_RETRIES=2
MAX_INVITE_LINKS_PER_BATCH=100
EXPIRED_LINK_REISSUE_HOURS=24
RECEIPT_MAX_DOWNLOAD_MB=20

AI_ENABLED=false
OCR_ENABLED=false
SMART_REPLIES_ENABLED=false

TELEGRAM_STARS_ENABLED=true
# Stars charged per 1 USD after converting the plan currency to USD.
TELEGRAM_STARS_PER_USD=44.11764706
# Backwards compatible fallback if TELEGRAM_STARS_PER_USD is not set.
TELEGRAM_STARS_DEFAULT_RATIO=44.11764706
EXTERNAL_PAYMENTS_ENABLED=false
EXTERNAL_PAYMENT_WEBHOOK_SECRET=
MINI_APP_CLIENT_URL=https://your-service.seenode.app/miniapp
MINI_APP_ADMIN_URL=https://your-service.seenode.app/admin
TELEGRAM_WEBHOOK_SECRET_TOKEN=

WEB_ENABLED=true
WEB_HOST=0.0.0.0
# Seenode/Railway normally inject PORT. Use 8000 for local HTTP-only checks.
PORT=8000
TELEGRAM_WEBAPP_MAX_AGE_SECONDS=86400

AUTO_CREATE_DB=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
